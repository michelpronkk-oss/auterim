# Copy to .env.local only after retrieving the dedicated Auterim project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Prefer the current secret key; the service-role name is supported for compatibility.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

TRIGGER_SECRET_KEY=
RESEND_API_KEY=
# Optional; only needed for live semantic classification. Never expose publicly.
AI_GATEWAY_API_KEY=
# Optional provider-neutral model identifier, such as an explicitly chosen AI Gateway model.
AUTERIM_CLASSIFIER_MODEL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
