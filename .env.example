# Copy to .env.local only after retrieving the dedicated Auterim project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Prefer the current secret key; the service-role name is supported for compatibility.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

TRIGGER_SECRET_KEY=
RESEND_API_KEY=
# Required with RESEND_API_KEY to enable transactional notification email.
RESEND_FROM_EMAIL=
# Explicit opt-in required before the Trigger dispatcher can send live notification emails.
AUTERIM_NOTIFICATION_EMAIL_LIVE=0
# Server-side Dodo Payments credentials. Use test_mode during integration verification.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_CORE_MONTHLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_BUSINESS_MONTHLY=
# Enables OpenAI semantic classification and customer impact assessment. Server-side only.
OPENAI_API_KEY=
AUTERIM_CLASSIFIER_PROVIDER=openai
AUTERIM_CLASSIFIER_MODEL=gpt-6.1-sol
# Optional GitHub App. Keep every value server-side; installation tokens are never persisted.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Optional Slack OAuth app. Minimal bot scopes are channels:read and chat:write.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
# Optional Linear OAuth app. Uses read + issues:create with PKCE.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=
# Optional Sentry OAuth app. Uses org:read, project:read, event:read with PKCE.
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=
SENTRY_REDIRECT_URI=
# Server-only base64 32-byte AES-256 keys keyed by version; retain old versions while rows use them.
# Example shape only: {"1":"<BASE64_32_BYTE_KEY>"}
CONNECTOR_CREDENTIAL_ENCRYPTION_KEYS=
CONNECTOR_CREDENTIAL_ACTIVE_KEY_VERSION=1
# Internal Auterim Growth Engine Search Console integration. Read-only, exact property only.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=
GOOGLE_SEARCH_CONSOLE_PROPERTY=sc-domain:auterim.com
# Comma-separated Auterim staff emails allowed to initiate/reconnect the internal integration.
AUTERIM_GROWTH_ADMIN_EMAILS=
# Optional live evaluation must target an Auterim-owned fixture repository only.
AUTERIM_PREFLIGHT_LIVE=0
# AUTERIM_PREFLIGHT_FIXTURE_OWNER=michelpronkk-oss
# AUTERIM_PREFLIGHT_FIXTURE_REPOSITORY=auterim-preflight-fixture
# AUTERIM_PREFLIGHT_FIXTURE_INSTALLATION_ID=
# AUTERIM_PREFLIGHT_FIXTURE_REPOSITORY_ID=
# AUTERIM_PREFLIGHT_FIXTURE_BRANCH=main
# AUTERIM_PREFLIGHT_FIXTURE_ENTITY=AUTERIM_PREFLIGHT_FIXTURE
NEXT_PUBLIC_APP_URL=http://localhost:3000
